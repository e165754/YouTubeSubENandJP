# YouTube Data API v3（検索に必須）
# Google Cloud Console で取得し、YouTube Data API v3 を有効化してください。
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here

# OpenAI 互換の Chat Completions API（単語解析）
OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key_here
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# 互換エイリアス（どちらかが設定されていれば利用されます）
OPENAI_API_KEY=

# --- 機械翻訳フォールバック（任意・日本語字幕が YouTube から十分取れないとき）---
# 優先: GOOGLE_CLOUD_TRANSLATION_API_KEY があれば Google Translation API v2（バッチ・速い）
# GOOGLE_CLOUD_TRANSLATION_API_KEY=
#
# またはローカル LibreTranslate（例）:
# docker run -d --name libretranslate -p 5000:5000 libretranslate/libretranslate
# LIBRETRANSLATE_BASE_URL=http://127.0.0.1:5000
# インスタンスが API キー必須のときのみ
# LIBRETRANSLATE_API_KEY=
