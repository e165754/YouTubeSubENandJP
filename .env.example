# YouTube Data API v3（検索に必須）
# Google Cloud Console で取得し、YouTube Data API v3 を有効化してください。
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here

# OpenAI 互換の Chat Completions API（単語解析）
OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key_here
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# 互換エイリアス（どちらかが設定されていれば利用されます）
OPENAI_API_KEY=

# --- 字幕のローカル翻訳（任意）---
# 日本語が欠ける行は @xenova/transformers（NLLB）でサーバー上で補完する（翻訳 API キー不要）。
# 詳細: docs/ローカル字幕翻訳_NLLB.md
# サーバーレス本番で無効にする場合:
# DISABLE_LOCAL_NLLB_SUBTITLE_TRANSLATION=1
#
# YouTube から日本語が 1 行も取れない動画では、既定ではローカル NLLB で全文を翻訳しない
# （長尺で /api/captions がタイムアウトし、英語字幕も表示されなくなるのを防ぐ）。
# 全文をローカル翻訳したい場合のみ:
# ENABLE_LOCAL_NLLB_FOR_ENGLISH_ONLY_TRANSCRIPTS=1
#
# macOS の next dev: ONNX の CleanUnusedInitializers 行はネイティブが stream をバイパスしうるため、
# package.json の dev は scripts/next-dev-filter-onnx-clean-unused-initializer-lines-on-stderr.sh で stderr をフィルタする。
# 生ログを見たいとき:
# DISABLE_ONNX_CLEAN_UNUSED_INITIALIZER_STDERR_FILTER=1

# --- 字幕パイプラインのデバッグログ（任意・開発時）---
# サーバー（ターミナル）: /api/captions 内の取得・マージ・補完の流れ
# DEBUG_YOUTUBE_CAPTION_PIPELINE=1
# ブラウザの開発者ツール Console: fetch 結果とリスト件数（ビルド時に埋め込まれるため dev 再起動が必要）
# NEXT_PUBLIC_DEBUG_YOUTUBE_CAPTION_PIPELINE=1
#
# --- 字幕と再生位置の同期（任意・クライアント）---
# 行判定は「再生時刻 − この秒」。正で遅れ、負で進む（既定 -0.35）。範囲は概ね -5〜5。
# 変更後は next dev を再起動。
# NEXT_PUBLIC_SUBTITLE_PLAYBACK_SYNC_LAG_SECONDS=-0.35
